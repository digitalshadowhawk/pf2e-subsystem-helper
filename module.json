{
  "id": "pf2e-subsystem-helper",
  "title": "PF2e Subsystem Helper",
  "description": "Research, Influence, Reputation, Chases, Infiltration, Victory Points, and Hacking subsystems for PF2e and SF2e.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Digitalshadowhawk",
      "url": "https://github.com/digitalshadowhawk/",
      "discord": "digitalshadowhawk",
      "flags": {}
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {}
      },
      {
        "id": "sf2e",
        "type": "system",
        "compatibility": {}
      }
    ]
  },
  "esmodules": [
    "src/pf2e-subsystem-helper.mjs"
  ],
  "styles": [
    "styles/pf2e-subsystem-helper.css",
    "styles/subsystem-sheets.css"
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "styles",
        "templates",
        "languages"
      ]
    }
  },
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json"
    }
  ],
  "url": "#{URL}#",
  "manifest": "#{MANIFEST}#",
  "download": "#{DOWNLOAD}#",
  "license": "LICENSE",
  "readme": "README.md",
  "media": [
    {
      "type": "icon",
      "url": "https://avatars.githubusercontent.com/u/10997407",
      "loop": false
    }
  ]
}