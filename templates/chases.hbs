<section class="tab panel standard-form{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}"
    data-tab="{{tab.id}}">
    {{#if @root.isGM}}
    <select name="chases.journal">
        {{selectOptions journalChoices selected=chasesJournal blank="— Select a chase journal —"}}
    </select>
    <p class="hint">{{{instructions}}}</p>
    {{/if}}
    {{#if topics.length}}
    <ol class="topics scrollable">
        {{~#each topics as |chase|~}}
        <li class="topic chase{{#if chase.expanded}} expanded{{/if}}" data-subsystem="chases"
            data-topic="{{chase.pageId}}">
            <div class="form-group">
                <button type="button" class="ui-control icon fa-solid fa-caret-right toggle-checks"
                    data-action="toggleChecks" data-tooltip
                    aria-label="{{localize 'PF2E-SUBSYSTEM-HELPER.Chases.Expand'}}"></button>
                <label>{{{chase.pageLink}}}</label>
                <div class="form-fields chase-summary">
                    <span class="chase-status {{chase.statusTone}}">{{chase.statusLabel}}</span>
                    <span class="chase-round">{{chase.roundLabel}}</span>
                </div>
                {{#if @root.isGM}}
                <div class="controls split-button">
                    <button type="button" class="ui-control icon {{chase.discoveredIcon}}"
                        data-action="toggleTopicDiscovered" data-tooltip
                        aria-label="{{chase.discoveredTooltip}}"></button>
                    <button type="button" class="ui-control icon fa-solid fa-message-arrow-up-right"
                        data-action="chasePost" data-tooltip
                        aria-label="{{localize 'PF2E-SUBSYSTEM-HELPER.Chases.Post'}}" {{#unless
                        chase.current}}disabled{{/unless}}></button>
                </div>
                {{/if}}
            </div>

            <div class="checks chase-panel">
                {{#if (and @root.isGM chase.lengthHint)}}
                <p class="chase-hint"><i class="fa-solid fa-triangle-exclamation"></i> {{chase.lengthHint}}</p>
                {{/if}}
                {{! ---------- Track ---------- }}
                <ol class="chase-track">
                    {{#each chase.track as |card|}}
                    <li
                        class="chase-card{{#if card.finish}} finish{{/if}}{{#if card.cleared}} cleared{{/if}}{{#if card.current}} current{{/if}}{{#unless card.revealed}} face-down{{/unless}}{{#if card.unrevealed}} unrevealed{{/if}}">
                        <span class="card-index">
                            {{#if card.finish}}<i class="fa-solid fa-flag-checkered"></i>{{else}}{{card.index}}{{/if}}
                        </span>
                        <span class="card-name">{{#if card.revealed}}{{card.name}}{{else}}?{{/if}}</span>
                        <span class="card-markers">
                            {{#if card.party}}
                            <i class="fa-solid fa-users party" data-tooltip
                                aria-label="{{localize 'PF2E-SUBSYSTEM-HELPER.Chases.Party'}}"></i>
                            {{/if}}
                            {{#if card.opponent}}
                            <i class="fa-solid fa-person-running opponent" data-tooltip
                                aria-label="{{localize 'PF2E-SUBSYSTEM-HELPER.Chases.Opponent'}}"></i>
                            {{/if}}
                        </span>
                    </li>
                    {{/each}}
                </ol>

                {{! ---------- Current obstacle ---------- }}
                {{#if chase.current}}
                <div class="chase-obstacle">
                    <header>
                        <strong>{{chase.current.name}}</strong>
                        {{#if chase.current.levelLabel}}<span class="level">{{chase.current.levelLabel}}</span>{{/if}}
                        <span class="cp">{{chase.current.points}} / {{chase.current.required}} CP</span>
                    </header>
                    <div class="form-fields">
                        <div class="track">
                            <range-picker name="chases.topics.{{chase.pageId}}.points" value="{{chase.current.points}}"
                                min="0" max="{{chase.current.required}}" step="1" {{#unless
                                @root.isGM}}disabled{{/unless}}></range-picker>
                            <datalist>
                                {{#each chase.current.markers as |m|}}
                                <option label="|" style="--pos: {{m.pos}}"></option>
                                {{/each}}
                            </datalist>
                        </div>
                    </div>
                    {{#if @root.isGM}}
                    <div class="chase-awards">
                        <button type="button" class="award crit-success" data-action="chaseAward" data-amount="2">
                            {{localize "PF2E-SUBSYSTEM-HELPER.Chases.CritSuccess"}}</button>
                        <button type="button" class="award success" data-action="chaseAward" data-amount="1">
                            {{localize "PF2E-SUBSYSTEM-HELPER.Chases.Success"}}</button>
                        <button type="button" class="award crit-fail" data-action="chaseAward" data-amount="-1">
                            {{localize "PF2E-SUBSYSTEM-HELPER.Chases.CritFail"}}</button>
                    </div>
                    {{/if}}
                    {{#if chase.current.description}}
                    <div class="obstacle-description">{{{chase.current.description}}}</div>
                    {{/if}}
                    {{#if chase.current.checks.length}}
                    <ul class="obstacle-checks">
                        {{#each chase.current.checks as |c|}}<li>{{{c}}}</li>{{/each}}
                    </ul>
                    {{/if}}
                    {{#if chase.current.options.length}}
                    <ul class="obstacle-options">
                        {{#each chase.current.options as |o|}}
                        <li><i class="fa-solid fa-wand-sparkles"></i> <span>{{{o}}}</span></li>
                        {{/each}}
                    </ul>
                    {{/if}}
                </div>
                {{/if}}

                {{! ---------- GM controls ---------- }}
                {{#if @root.isGM}}
                <div class="chase-controls">
                    <div class="chase-moves">
                        <span class="move-group">
                            <i class="fa-solid fa-users"></i>
                            <button type="button" class="ui-control icon fa-solid fa-backward-step"
                                data-action="chaseMove" data-who="party" data-delta="-1" data-tooltip
                                aria-label="{{localize 'PF2E-SUBSYSTEM-HELPER.Chases.PartyBack'}}"></button>
                            <button type="button" class="ui-control icon fa-solid fa-forward-step"
                                data-action="chaseMove" data-who="party" data-delta="1" data-tooltip
                                aria-label="{{localize 'PF2E-SUBSYSTEM-HELPER.Chases.PartyForward'}}"></button>
                        </span>
                        {{#if chase.hasOpponent}}
                        <span class="move-group">
                            <i class="fa-solid fa-person-running"></i>
                            <button type="button" class="ui-control icon fa-solid fa-backward-step"
                                data-action="chaseMove" data-who="opponent" data-delta="-1" data-tooltip
                                aria-label="{{localize 'PF2E-SUBSYSTEM-HELPER.Chases.OpponentBack'}}"></button>
                            <button type="button" class="ui-control icon fa-solid fa-forward-step"
                                data-action="chaseMove" data-who="opponent" data-delta="1" data-tooltip
                                aria-label="{{localize 'PF2E-SUBSYSTEM-HELPER.Chases.OpponentForward'}}"></button>
                        </span>
                        {{/if}}
                        <button type="button" class="ui-control icon fa-solid fa-eye" data-action="chaseReveal"
                            data-tooltip aria-label="{{localize 'PF2E-SUBSYSTEM-HELPER.Chases.RevealNext'}}" {{#unless
                            chase.canReveal}}disabled{{/unless}}></button>
                    </div>
                    <div class="chase-round-controls">
                        <button type="button" data-action="chaseNextRound">
                            <i class="fa-solid fa-forward"></i> {{localize "PF2E-SUBSYSTEM-HELPER.Chases.NextRound"}}
                        </button>
                        <button type="button" data-action="chaseReset">
                            <i class="fa-solid fa-rotate-left"></i> {{localize "PF2E-SUBSYSTEM-HELPER.Chases.Reset"}}
                        </button>
                    </div>
                    <div class="chase-settings">
                        <label>
                            {{localize "PF2E-SUBSYSTEM-HELPER.Chases.PartySize"}}
                            <input type="number" name="chases.topics.{{chase.pageId}}.partySize"
                                value="{{chase.partySize}}" placeholder="{{chase.detectedPartySize}}" min="1" step="1">
                        </label>
                        <label>
                            {{localize "PF2E-SUBSYSTEM-HELPER.Chases.TypeLabel"}}
                            <select name="chases.topics.{{chase.pageId}}.type">
                                {{selectOptions @root.typeChoices selected=chase.type}}
                            </select>
                        </label>
                        {{#if chase.hasOpponent}}
                        <label>
                            {{localize "PF2E-SUBSYSTEM-HELPER.Chases.Pace"}}
                            <input type="number" name="chases.topics.{{chase.pageId}}.pace" value="{{chase.pace}}"
                                min="0" step="1">
                        </label>
                        {{/if}}
                        {{#if chase.isBeatTheClock}}
                        <label>
                            {{localize "PF2E-SUBSYSTEM-HELPER.Chases.Rounds"}}
                            <input type="number" name="chases.topics.{{chase.pageId}}.rounds"
                                value="{{chase.storedRounds}}" placeholder="{{chase.obstacleCount}}" min="1" step="1">
                        </label>
                        {{/if}}
                    </div>
                </div>
                {{/if}}
            </div>
        </li>
        {{~/each~}}
    </ol>
    {{else}}
    <p class="hint">{{#if @root.isGM}}Select a journal whose pages contain chases.{{else}}No chases underway.{{/if}}</p>
    {{/if}}
</section>