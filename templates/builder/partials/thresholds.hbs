{{! Shared: numeric thresholds. Context: model.thresholds, thresholdsHint, thresholdUnit }}
{{! ---------- Thresholds ---------- }}
<fieldset class="builder-section">
    <legend>{{localize "PF2E-SUBSYSTEM-HELPER.Builder.Thresholds"}}</legend>
    <p class="hint">{{localize @root.thresholdsHint}}</p>
    {{#each model.thresholds as |t ti|}}
    <div class="builder-row threshold-row" data-row="threshold">
        <span class="threshold-points">
            <input type="number" name="thresholds.{{ti}}.points" value="{{t.points}}" min="0" step="1">
            <span class="unit">{{localize @root.thresholdUnit}}</span>
        </span>
        <textarea name="thresholds.{{ti}}.html" rows="2"
            placeholder="{{localize 'PF2E-SUBSYSTEM-HELPER.Builder.ThresholdPlaceholder'}}">{{t.html}}</textarea>
        <span class="row-controls">
            <button type="button" class="ui-control icon fa-solid fa-xmark" data-action="removeRow"
                data-path="thresholds" data-index="{{ti}}" data-tooltip
                aria-label="{{localize 'PF2E-SUBSYSTEM-HELPER.Builder.Remove'}}"></button>
        </span>
    </div>
    {{/each}}
    <button type="button" class="add-row" data-action="addRow" data-path="thresholds">
        <i class="fa-solid fa-plus"></i> {{localize "PF2E-SUBSYSTEM-HELPER.Builder.AddThreshold"}}
    </button>
</fieldset>