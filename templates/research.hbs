<section class="tab panel standard-form{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}"
    data-tab="{{tab.id}}">
    {{#if @root.isGM}}
    <select name="research.journal">
        {{selectOptions journalChoices selected=journal blank="— Select a research journal —"}}
    </select>
    <p class="hint">{{{instructions}}}</p>
    {{/if}}
    {{#if topics.length}}
    <ol class="topics scrollable">
        {{~#each topics as |topic|~}}
        <li class="topic{{#if topic.expanded}} expanded{{/if}}" data-subsystem="research" data-topic="{{topic.pageId}}">
            <div class="form-group">
                {{#if @root.isGM}}
                <button type="button" class="ui-control icon fa-solid fa-caret-right toggle-checks"
                    data-action="toggleChecks" data-tooltip aria-label="{{topic.checksTooltip}}" {{#unless
                    topic.checks.length}}disabled{{/unless}}></button>
                {{/if}}
                <label for="{{../rootId}}-research.{{topic.pageId}}.points">{{{topic.pageLink}}}</label>
                <div class="form-fields">
                    <div class="track">
                        <range-picker name="research.topics.{{topic.pageId}}.points"
                            id="{{../rootId}}-research.{{topic.pageId}}.points" value="{{topic.points}}" min="0"
                            max="{{topic.max}}" step="1" {{#unless
                            topic.sliderEditable}}disabled{{/unless}}></range-picker>
                        <datalist>
                            {{#each topic.markers as |m|}}
                            <option label="{{#if m.threshold}}&#xf0d8;{{else}}|{{/if}}" {{#if m.threshold}}class="caret"
                                {{/if}} style="--pos: {{m.pos}}"></option>
                            {{/each}}
                        </datalist>
                    </div>
                </div>
                {{#if @root.isGM}}
                <div class="controls split-button">
                    <button type="button" class="ui-control icon {{topic.discoveredIcon}}"
                        data-action="toggleTopicDiscovered" data-tooltip
                        aria-label="{{topic.discoveredTooltip}}"></button>
                    <button type="button" class="ui-control icon fa-solid fa-message-arrow-up-right"
                        data-action="resultsToChat" data-tooltip aria-label="{{topic.toChatTooltip}}" {{#unless
                        topic.hasResults}}disabled{{/unless}}></button>
                </div>
                {{/if}}
            </div>
            {{#if topic.checks.length}}
            <div class="checks">
                {{#each topic.checks as |group|}}
                {{#each topic.checks as |group|}}
                <div class="check-group">
                    <div class="check-group-header">
                        {{#if group.label}}<strong>{{group.label}}</strong>{{/if}}
                        <div class="category-points">
                            <div class="track">
                                <range-picker name="research.topics.{{topic.pageId}}.categories.{{group.key}}"
                                    value="{{group.points}}" min="0" max="{{group.sliderMax}}" step="1" {{#unless
                                    topic.categoriesEditable}}disabled{{/unless}}></range-picker>
                                <datalist>
                                    {{#each group.markers as |m|}}
                                    <option label="|" style="--pos: {{m.pos}}"></option>
                                    {{/each}}
                                </datalist>
                            </div>
                        </div>
                    </div>
                    {{#each group.checks as |check|}}
                    <div class="check">
                        {{{check.html}}}
                        {{#if check.label}}<span class="check-label">{{check.label}}</span>{{/if}}
                    </div>
                    {{/each}}
                </div>
                {{/each}}
                {{/each}}
            </div>
            {{/if}}
        </li>
        {{~/each~}}
    </ol>
    {{else}}
    <p class="hint">{{#if @root.isGM}}Select a journal whose pages contain research topics.{{else}}No research topics discovered yet.{{/if}}</p>
    {{/if}}
</section>